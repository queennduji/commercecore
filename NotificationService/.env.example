# Copy this file to .env (same folder) and fill in your own Resend + Twilio credentials.
# .env is gitignored — this file (.env.example) is the only one that gets committed.

# Resend: get a free key at https://resend.com/signup — no card required, 3,000 emails/month
# permanently. Resend's sandbox sender (onboarding@resend.dev, the default FromAddress in
# appsettings) can send to the email address you signed up with immediately, no domain
# verification needed.
RESEND_API_KEY=re_...

# Twilio: get a free trial account at https://www.twilio.com/try-twilio (Account SID + Auth Token
# on the console dashboard; a trial From number is provisioned for you). Trial accounts can only
# send SMS to phone numbers you've verified in the console (Phone Numbers > Verified Caller IDs) —
# see NotificationService/README.md.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_PHONE_NUMBER=+1...
