{
  "info": {
    "name": "CatalogService",
    "description": "CommerceCore CatalogService — categories/products CRUD against the Docker container. Includes an Auth folder that logs into AuthenticationService (also via Docker) to obtain the bearer token CatalogService's write endpoints require.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8086" },
    { "key": "authBaseUrl", "value": "http://localhost:8085" },
    { "key": "email", "value": "catalog-postman@example.com" },
    { "key": "password", "value": "P@ssw0rd123!" },
    { "key": "accessToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "imageUploadUrl", "value": "" },
    { "key": "imageObjectKey", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "imageUrl", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (via AuthenticationService)",
      "item": [
        {
          "name": "Register (idempotent)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{authBaseUrl}}/api/auth/register", "host": ["{{authBaseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (new) or 400 (already registered)', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (get token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{authBaseUrl}}/api/auth/login", "host": ["{{authBaseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Gadgets\",\n  \"parentCategoryId\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('categoryId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Updated description\",\n  \"parentCategoryId\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204, or 400 if products are still assigned', function () {",
                  "    pm.expect([204, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Widget\",\n  \"description\": \"A widget\",\n  \"sku\": \"SKU-{{$randomInt}}\",\n  \"price\": 19.99,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('productId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?categoryId={{categoryId}}&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Widget Pro\",\n  \"description\": \"An upgraded widget\",\n  \"price\": 29.99,\n  \"status\": \"Active\",\n  \"categoryId\": \"{{categoryId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Delete (archives)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 204', function () { pm.response.to.have.status(204); });"] }
            }
          ]
        },
        {
          "name": "Images - 1. Request Upload URL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}/images/upload-url", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}", "images", "upload-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"photo.png\",\n  \"contentType\": \"image/png\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('imageUploadUrl', body.uploadUrl);",
                  "pm.collectionVariables.set('imageObjectKey', body.objectKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "Images - 2. Upload to MinIO directly",
          "request": {
            "auth": { "type": "noauth" },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "image/png" }],
            "url": { "raw": "{{imageUploadUrl}}", "host": ["{{imageUploadUrl}}"] },
            "body": { "mode": "file", "file": {} },
            "description": "Attach an image file in the Body tab before sending — Postman can't reference your filesystem from a shared collection. This PUT goes straight to MinIO, never through CatalogService, matching the pre-signed upload flow."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Images - 3. Attach",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}/images", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}", "images"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objectKey\": \"{{imageObjectKey}}\",\n  \"sortOrder\": 0,\n  \"isPrimary\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('imageId', body.id);",
                  "pm.collectionVariables.set('imageUrl', body.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Images - 4. Delete",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}/images/{{imageId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}", "images", "{{imageId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 204', function () { pm.response.to.have.status(204); });"] }
            }
          ]
        }
      ]
    }
  ]
}
