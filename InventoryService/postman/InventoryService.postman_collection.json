{
  "info": {
    "name": "InventoryService",
    "description": "CommerceCore InventoryService — locations, stock adjustments, and reservations against the Docker container. Includes an Auth folder that logs into AuthenticationService (also via Docker) to obtain the bearer token this service's write endpoints require, and a Kafka folder note explaining the auto-provisioning flow from CatalogService.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088" },
    { "key": "authBaseUrl", "value": "http://localhost:8085" },
    { "key": "email", "value": "inventory-postman@example.com" },
    { "key": "password", "value": "P@ssw0rd123!" },
    { "key": "accessToken", "value": "" },
    { "key": "locationId", "value": "" },
    { "key": "locationBId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (via AuthenticationService)",
      "item": [
        {
          "name": "Register (idempotent)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{authBaseUrl}}/api/auth/register", "host": ["{{authBaseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (new) or 400 (already registered)', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (get token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{authBaseUrl}}/api/auth/login", "host": ["{{authBaseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Locations",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/locations", "host": ["{{baseUrl}}"], "path": ["api", "locations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"East Warehouse\",\n  \"code\": \"WH-EAST-{{$randomInt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('locationId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create second location (for multi-location testing)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/locations", "host": ["{{baseUrl}}"], "path": ["api", "locations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"West Warehouse\",\n  \"code\": \"WH-WEST-{{$randomInt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('locationBId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/locations/{{locationId}}", "host": ["{{baseUrl}}"], "path": ["api", "locations", "{{locationId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "List",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/locations", "host": ["{{baseUrl}}"], "path": ["api", "locations"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/locations/{{locationId}}", "host": ["{{baseUrl}}"], "path": ["api", "locations", "{{locationId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"East Warehouse (Renamed)\",\n  \"code\": \"WH-EAST-{{$randomInt}}\",\n  \"isActive\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Deactivate",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/locations/{{locationId}}", "host": ["{{baseUrl}}"], "path": ["api", "locations", "{{locationId}}"] },
            "description": "Returns 204 only if this location holds zero on-hand/reserved stock; 400 otherwise. Run this before adjusting stock at this location, or against a fresh location."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204, or 400 if stock is still present', function () {",
                  "    pm.expect([204, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Adjust stock (restock)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/adjust", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "adjust"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"locationId\": \"{{locationId}}\",\n  \"delta\": 50,\n  \"reason\": \"initial stock\"\n}"
            },
            "description": "productId can be any GUID for manual testing — set it to a real product from CatalogService, or paste a fresh GUID here (a new inventory record is upserted automatically)."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Adjust stock (correction/damage)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/adjust", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "adjust"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"locationId\": \"{{locationId}}\",\n  \"delta\": -5,\n  \"reason\": \"damaged in transit\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Get at location",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/inventory/{{productId}}/{{locationId}}", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "{{productId}}", "{{locationId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Get across all locations",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/inventory/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "{{productId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "List (paginated, filterable)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/inventory?locationId={{locationId}}&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory"],
              "query": [
                { "key": "locationId", "value": "{{locationId}}" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Reserve",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"locationId\": \"{{locationId}}\",\n  \"quantity\": 10,\n  \"referenceId\": \"order-demo-1\"\n}"
            },
            "description": "Fails with 400 if Available (OnHand - Reserved) is less than the requested quantity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('reservationId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get reservation",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations", "{{reservationId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Release reservation",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations/{{reservationId}}/release", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations", "{{reservationId}}", "release"] },
            "description": "Gives the held stock back to Available without any of it leaving the building. Run 'Reserve' again first if you already committed this reservation below."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        },
        {
          "name": "Commit reservation",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/inventory/reservations/{{reservationId}}/commit", "host": ["{{baseUrl}}"], "path": ["api", "inventory", "reservations", "{{reservationId}}", "commit"] },
            "description": "Marks the reservation fulfilled and actually removes the stock (decrements both OnHand and Reserved). Only one of Release/Commit can succeed per reservation — re-run 'Reserve' if you already used the other."
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] }
            }
          ]
        }
      ]
    }
  ]
}
