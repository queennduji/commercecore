# Copy this file to .env (same folder) and fill in your own EasyPost test-mode API key.
# Get one free at https://www.easypost.com/signup — test keys start with EZAK and only ever
# create test-mode trackers, never real shipments or charges.
# .env is gitignored — this file (.env.example) is the only one that gets committed.

EASYPOST_API_KEY=EZAK...
