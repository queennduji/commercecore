# Template for deploy/.env.prod - the real file with actual values lives ONLY on the production
# VM (deploy/.env.prod is gitignored - see deploy/README.md). Never commit real secrets here.
#
# Generate strong random values for everything except STRIPE_SECRET_KEY, e.g.:
#   openssl rand -base64 32   # good for JWT_KEY
#   openssl rand -hex 20      # good for a DB password / MinIO secret key

# Shared JWT signing key - every service (including AuthenticationService, which sources this
# from appsettings.Development.json locally instead of an env var) must use the SAME value, or
# tokens signed by AuthenticationService won't validate anywhere else.
JWT_KEY=

# One unique password per service database - these are separate Postgres instances, not shared.
CATALOG_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
AUTH_DB_PASSWORD=
ORDER_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
SHIPPING_DB_PASSWORD=

# MinIO root credentials - also used directly as CatalogService's Minio:AccessKey/SecretKey.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Stripe *secret* key, test-mode (sk_test_...) - reuse the existing key already in
# PaymentService/.env (same Stripe account as the pk_test_... key wired into Storefront on
# Vercel), or supply a different test-mode key if you'd rather keep this deployment on its own.
STRIPE_SECRET_KEY=

# The email that gets the Admin role (product/category/inventory writes, refunds) - see
# deploy/README.md's "Becoming an admin" section. Leave blank for no admin account at all.
ADMIN_EMAIL=

# EasyPost *test-mode* API key (starts with EZAK) - reuse the existing key already in
# ShippingService/.env, or supply a different test-mode key if you'd rather keep this deployment
# on its own. Get one free at https://www.easypost.com/signup.
EASYPOST_API_KEY=
