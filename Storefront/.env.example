# For `npm run dev`: copy this file to .env.local and fill in both values.
# For `docker compose up`: ALSO copy this file to .env (Compose reads .env for its own
# ${VAR} interpolation in docker-compose.yml's build.args - a separate mechanism from .env.local,
# which only `npm run dev` reads). Same two values in both files.

# Base URL of the ApiGateway (YARP reverse proxy) that fronts every backend service.
# Local dev default - matches ApiGateway's host port (see repo root README.md).
# Public on purpose (NEXT_PUBLIC_ prefix): cart calls go straight from the browser to the
# gateway (anonymous-by-design routes), not just from Storefront's own server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Stripe *publishable* key (starts with pk_test_), from https://dashboard.stripe.com/test/apikeys -
# the same Stripe account as PaymentService's sk_test_... secret key (see PaymentService/.env).
# Public on purpose: publishable keys are designed to ship in client-side code.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
