# Copy this file to .env (same folder) and fill in your own Stripe test-mode secret key.
# Get one free at https://dashboard.stripe.com/test/apikeys after creating a Stripe account —
# it starts with sk_test_ and can only move fake test-mode money, never real funds.
# .env is gitignored — this file (.env.example) is the only one that gets committed.

STRIPE_SECRET_KEY=sk_test_...
