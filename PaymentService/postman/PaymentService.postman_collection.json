{
  "info": {
    "name": "PaymentService",
    "description": "CommerceCore PaymentService – real Stripe test-mode charges and refunds against the Docker container. Includes an Auth folder that logs into AuthenticationService. Uses Stripe's own built-in test PaymentMethod ids (pm_card_visa succeeds, pm_card_visa_chargeDeclined always declines) so no real card details or Stripe.js frontend are needed – but the container must be running with your own free Stripe test secret key configured (see PaymentService/README.md) for the Charge/Refund requests to actually reach Stripe.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8090" },
    { "key": "authBaseUrl", "value": "http://localhost:8085" },
    { "key": "email", "value": "payment-postman@example.com" },
    { "key": "password", "value": "P@ssw0rd123!" },
    { "key": "accessToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "declinedOrderId", "value": "" },
    { "key": "unpaidOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (via AuthenticationService)",
      "item": [
        {
          "name": "Register (idempotent)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{authBaseUrl}}/api/auth/register", "host": ["{{authBaseUrl}}"], "path": ["api", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (new) or 400 (already registered)', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (get token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{authBaseUrl}}/api/auth/login", "host": ["{{authBaseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Charge (succeeds)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/charge", "host": ["{{baseUrl}}"], "path": ["api", "payments", "charge"] },
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 42.50,\n  \"currency\": \"usd\",\n  \"paymentMethodId\": \"pm_card_visa\"\n}" },
            "description": "orderId is a fresh random guid generated by the pre-request script below – in real usage this would be a real OrderService order id, but PaymentService doesn't validate that the order actually exists (OrderService is the only caller and it's already validated ownership by the time it gets here). pm_card_visa is Stripe's built-in test PaymentMethod id that always succeeds."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('orderId', pm.variables.replaceIn('{{$guid}}'));"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Payment is Succeeded', function () { pm.expect(body.status).to.eql('Succeeded'); });",
                  "pm.collectionVariables.set('paymentId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "{{paymentId}}"] },
            "description": "Ownership-checked – returns 404 (not 403) if the payment belongs to a different caller."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
          ]
        },
        {
          "name": "List by order",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/payments/order/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "order", "{{orderId}}"] },
            "description": "Filtered to payments owned by the caller – an order belonging to someone else simply yields an empty list."
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }
          ]
        },
        {
          "name": "Refund",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/refund", "host": ["{{baseUrl}}"], "path": ["api", "payments", "refund"] },
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" },
            "description": "Refunds the most recent Succeeded payment for the order (run 'Charge (succeeds)' first). Ops action – no ownership check, mirrors OrderService's Refund. Requires an Admin-role token; the default {{email}} account from the Auth folder won't have one, so this will 403 until you log in as an admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Payment is Refunded', function () { pm.expect(body.status).to.eql('Refunded'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Failure paths",
      "item": [
        {
          "name": "Charge (declined card)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/charge", "host": ["{{baseUrl}}"], "path": ["api", "payments", "charge"] },
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{declinedOrderId}}\",\n  \"amount\": 15.00,\n  \"currency\": \"usd\",\n  \"paymentMethodId\": \"pm_card_visa_chargeDeclined\"\n}" },
            "description": "pm_card_visa_chargeDeclined is Stripe's built-in test PaymentMethod id that always declines. A Payment row is still recorded (Status: Failed, audit trail) but the request itself returns 400."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('declinedOrderId', pm.variables.replaceIn('{{$guid}}'));"] }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] }
            }
          ]
        },
        {
          "name": "Refund with no successful payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/refund", "host": ["{{baseUrl}}"], "path": ["api", "payments", "refund"] },
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{unpaidOrderId}}\"\n}" },
            "description": "A random order id with no charge history – proves refund fails cleanly instead of throwing."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('unpaidOrderId', pm.variables.replaceIn('{{$guid}}'));"] }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] }
            }
          ]
        }
      ]
    }
  ]
}
