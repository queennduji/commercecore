{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CommerceCore.AuthenticationService",
    "Audience": "CommerceCore"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Otel": {
    "ServiceName": "ApiGateway",
    "TracesEndpoint": "",
    "LogsEndpoint": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "catalog-products-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "catalog-categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      },
      "locations-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/locations/{**catch-all}" }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/carts/{**catch-all}" }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "shipments-route": {
        "ClusterId": "shipping-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/shipments/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "RequireAuthenticatedUser",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "catalog-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "inventory-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "cart-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "order-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "payment-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "shipping-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      },
      "notification-cluster": {
        "Destinations": { "d1": { "Address": "" } }
      }
    }
  }
}
